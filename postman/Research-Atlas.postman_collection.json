{
  "info": {
    "name": "Research Atlas \u2014 CRUD demonstration",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run in order against your own local database. Creates three sample records, deletes the first and leaves two for review. These examples are test fixtures, not frontend data."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:5050"
    },
    {
      "key": "opportunity_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01. Create opportunity 1",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/opportunities",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"research_title\": \"Measuring campus network reliability\",\n  \"research_description\": \"Investigate packet loss and latency across a controlled campus testbed.\",\n  \"research_area\": \"Computer Networks\",\n  \"faculty_name\": \"Dr. Example Faculty\",\n  \"department\": \"Computer Science\",\n  \"required_skills\": \"Python, Wireshark\",\n  \"available_positions\": 2,\n  \"application_deadline\": \"2026-12-15\",\n  \"status\": \"Open\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"opportunity_id\", pm.response.json().data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "02. Create opportunity 2",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/opportunities",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"research_title\": \"Energy-aware routing for sensor networks\",\n  \"research_description\": \"Investigate packet loss and latency across a controlled campus testbed.\",\n  \"research_area\": \"Computer Networks\",\n  \"faculty_name\": \"Dr. Example Faculty\",\n  \"department\": \"Computer Science\",\n  \"required_skills\": \"Python, Wireshark\",\n  \"available_positions\": 2,\n  \"application_deadline\": \"2026-12-15\",\n  \"status\": \"Open\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 201\", () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "03. Create opportunity 3",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/opportunities",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"research_title\": \"Visualizing internet traffic patterns\",\n  \"research_description\": \"Investigate packet loss and latency across a controlled campus testbed.\",\n  \"research_area\": \"Computer Networks\",\n  \"faculty_name\": \"Dr. Example Faculty\",\n  \"department\": \"Computer Science\",\n  \"required_skills\": \"Python, Wireshark\",\n  \"available_positions\": 2,\n  \"application_deadline\": \"2026-12-15\",\n  \"status\": \"Open\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 201\", () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "04. List opportunities",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/opportunities"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "05. Retrieve selected opportunity",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/opportunities/{{opportunity_id}}"
      },
      "event": [
